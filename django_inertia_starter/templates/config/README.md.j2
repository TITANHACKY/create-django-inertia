static/                      Frontend source
  main.{% if frontend == 'vue3' %}{% if use_typescript %}ts{% else %}js{% endif %}{% elif use_typescript %}tsx{% else %}jsx{% endif %}                   Inertia entry point
  pages/                     Page components (one folder per route)
