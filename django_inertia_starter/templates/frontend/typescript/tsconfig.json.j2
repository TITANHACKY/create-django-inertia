{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true{% if frontend == 'react' %},
    "jsx": "react-jsx"{% endif %},

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping - matches the "@" alias in vite.config.ts */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./static/*"]
    },

    /* import.meta.glob and friends */
    "types": ["vite/client"]
  },
  "include": ["static/**/*.ts", "static/**/*.d.ts"{% if frontend == 'react' %}, "static/**/*.tsx"{% endif %}{% if frontend == 'vue3' %}, "static/**/*.vue"{% endif %}],
  "exclude": ["static/dist"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
